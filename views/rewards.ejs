<%- include('partials/head', { title: 'Claimora' }) %>
<body>
<%- include('partials/public-header') %>

<main>
  <section class="rewards-section">
    <div id="reward-loading" class="loading">Loading current reward…</div>

    <div id="reward-content" class="hidden">
      <h1 id="reward-title"></h1>
      <p id="reward-description"></p>
      <div id="reward-details" class="detail-list"></div>
      <div id="reward-inactive-msg" class="notice hidden">
        There's no active giveaway right now. Please check back soon!
      </div>
      <button id="claim-btn" class="btn btn-primary btn-large">🏆 Claim Reward</button>
    </div>
  </section>

  <section id="claim-section" class="claim-section hidden">
    <h2>Claim Your Reward</h2>
    <div class="security-notice">
      🔒 Your Information is secured and private. It will only be used for system processing.
    </div>
    <form id="claim-form" autocomplete="off">
      <input type="text" name="hp_website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div id="form-fields"></div>
      <div id="form-message" class="form-message hidden"></div>
      <button type="submit" class="btn btn-primary btn-large" id="submit-btn">Submit Entry</button>
    </form>
  </section>
</main>

<%- include('partials/public-footer') %>
<script src="/js/rewards.js"></script>
</body>
</html>
